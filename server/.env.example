# ── Required secrets ─────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_KEY=YOUR-ANON-KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# ── Background jobs (RQ) ──────────────────────────────────────────────────────
# Redis broker. When unset, the API falls back to running jobs in-process
# (fine for local dev; a single instance only). Use the Upstash "rediss://"
# TLS URL in production.
REDIS_URL=redis://localhost:6379/0
JOB_QUEUE_NAME=compliance
JOB_TIMEOUT=600
# On Windows / single-core free tiers the worker cannot fork:
# RQ_SIMPLE_WORKER=1

# ── Rate limiting (slowapi) ───────────────────────────────────────────────────
# Counters use REDIS_URL when set, else in-process memory.
RATE_LIMIT_AUTH=5/minute
RATE_LIMIT_GENERATE=5/minute
RATE_LIMIT_QUERY=30/minute
RATE_LIMIT_JOBS=120/minute

# ── Security ──────────────────────────────────────────────────────────────────
# Comma-separated allow list (NO wildcard — credentials are enabled).
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000
# Send HSTS only when actually served over TLS.
ENABLE_HSTS=false
SUPABASE_USER_CACHE_TTL=60

# ── Limits ────────────────────────────────────────────────────────────────────
MAX_UPLOAD_BYTES=52428800
MAX_TOTAL_UPLOAD_BYTES=157286400
MAX_PAGES_PER_PDF=30

# ── Models (override per environment) ─────────────────────────────────────────
OPENAI_VISION_MODEL=gpt-4o
OPENAI_ORCHESTRATOR_MODEL=gpt-4o-mini
OPENAI_VALIDATOR_MODEL=gpt-4o-mini
OPENAI_FINAL_REPORT_MODEL=o4-mini

# ── RAG knobs ─────────────────────────────────────────────────────────────────
RERANK_ENABLED=true
MMR_ENABLED=true
MMR_LAMBDA=0.7
RAG_TOP_N=40
RAG_TOP_K=10
RAG_PER_QUERY_K=5
RAG_MAX_SUBQUERIES=8
RAG_MIN_SCORE=0.0

# ── Server (local run via `python main.py`) ───────────────────────────────────
HOST=0.0.0.0
PORT=8000
RELOAD=false
LOG_LEVEL=INFO
